/* Clavier KeePass : l'utilisateur qui l'a installé peut retirer ses fichiers système
 * (et uniquement eux) sans mot de passe, depuis les Paramètres. */
polkit.addRule(function(action, subject) {
    if (action.id === "org.keepasskbd.uninstall" && subject.user === "@USER@")
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
